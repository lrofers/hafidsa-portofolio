{
  "name": "immersive-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portofolio galeri 3D (Three.js + GSAP) dengan admin CMS berbasis Supabase.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "create-admin": "node server/scripts/create-admin.js",
    "gen:demo": "node scripts/generate-demo-art.mjs",
    "local:setup": "npm --prefix tools/local-supabase install && npm --prefix tools/local-supabase run setup",
    "local:supabase": "node tools/local-supabase/start.mjs",
    "test:layout": "node scripts/test-layout.mjs",
    "test:ring": "node scripts/test-ring-architecture.mjs",
    "test:statues": "node scripts/test-statues.mjs",
    "test:gallery": "node scripts/test-gallery.mjs",
    "test:schema": "node scripts/test-schema.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test": "npm run test:layout && npm run test:ring && npm run test:statues && npm run test:schema && npm run test:gallery && npm run test:e2e"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.0",
    "lucide": "^1.61.0",
    "puppeteer-core": "^25.16.0",
    "three": "^0.186.1",
    "vite": "^8.3.5"
  }
}
