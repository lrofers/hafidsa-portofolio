# ---------------------------------------------------------------------------
# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit `.env`.
# ---------------------------------------------------------------------------

# === Frontend — dibaca saat `npm run dev` / `npm run build` (AMAN dipublikasikan) ===
# Supabase Dashboard › Project Settings › API (atau API Keys)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "Publishable key" (sb_publishable_…) atau "anon public" key. BUKAN service-role/secret key.
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# === Server Express & skrip admin — RAHASIA (hanya di komputer/server Anda) ===
PORT=3000
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Dipakai oleh `npm run create-admin` dan endpoint /api/contact. JANGAN pernah diberi awalan VITE_.
# Boleh dikosongkan di server: formulir kontak lalu memakai fungsi database submit_contact_message (anon key).
SUPABASE_SERVICE_ROLE_KEY=

# Jumlah reverse proxy di depan server (Render/Railway/Fly/Nginx = 1). 0 bila server langsung terekspos.
TRUST_PROXY=0
# Opsional: origin tambahan yang boleh mengirim formulir kontak (pisahkan koma), mis. https://www.domain.com
ALLOWED_ORIGINS=
# Opsional: garam untuk hash IP pengirim pesan (anti-spam tanpa menyimpan IP asli)
IP_HASH_SALT=
# Opsional: folder hasil build yang disajikan server (bawaan: dist)
DIST_DIR=
